<script>
  // Mark the current page; "/" and "/index.html" both count as Home.
  (function () {
    var here = location.pathname.replace(/\/$/, '/index.html').split('/').pop();
    document.querySelectorAll('.site-nav a:not(.site-brand)').forEach(function (a) {
      if (a.getAttribute('href') === here) a.setAttribute('aria-current', 'page');
    });
  })();
</script>
